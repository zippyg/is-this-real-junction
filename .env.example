EXA_API_KEY= # Exa secret required for live web retrieval.
EXA_CALL_LIMIT= # Optional provider-call limit in the shared retrieval client.
EXA_ENV_FILE= # Explicit local dotenv file; never commit its contents.
NEMOTRON_API_KEY= # Optional wording-model secret; unnecessary for the main demonstrations.
NEMOTRON_BASE_URL= # Optional wording-model endpoint; not used to decide links or checker findings.
NEMOTRON_MODEL= # Optional wording-model name.
REAL_BUDGET_USD= # Task budget in reported dollars, subject to the built-in ceiling.
REAL_KILL_SWITCH= # Stop live retrieval without removing the key.
REAL_LEDGER= # Writable SQLite cost-ledger path; local to one filesystem.
REAL_LIVE_ENABLED= # Enable live Exa retrieval; disabled by default.
VERCEL= # Hosting-platform marker normally supplied by Vercel.
